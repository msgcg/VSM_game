# Sber AI Ecosystem (GigaChat)
# Внимание: Авторизационные ключи указываются персонально каждым проводником в интерфейсе ВСМ.
# Системных глобальных ключей нет.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-Max

# Речевой стек ВСМ:
# 1. Распознавание речи (STT): Локальный модуль Whisper с Vulkan GPU-ускорением (100% автономно)
# 2. Синтез речи (TTS): Microsoft Edge Neural TTS многоголосый (без дискового кэширования)

# Sber ID OAuth 2.0 (для партнерских интеграций)
SBER_ID_CLIENT_ID=
SBER_ID_CLIENT_SECRET=
SBER_ID_REDIRECT_URI=http://127.0.0.1:8000/auth/sber/callback/
